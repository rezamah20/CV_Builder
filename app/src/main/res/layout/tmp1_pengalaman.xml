<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="154dp"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="4dp"
        android:paddingBottom="5dp"
        >
            <TextView
                android:id="@+id/tmp1_tv_item_nama_perusahaan"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="start"
                android:text="PT. Depo Java Container"
                android:textColor="@color/black"
                android:textSize="8sp"
                android:textStyle="bold" />
        <TextView
            android:id="@+id/tmp1_tv_jabatan_peng_txt"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="start"
            android:text="Manager"
            android:textColor="@color/black"
            android:textSize="7sp" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                >
                <TextView
                    android:id="@+id/tmp1_tgl_masuk_perusahaan_txt"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="12 Desember 2013"
                    android:textSize="5sp"
                    android:textColor="@color/black"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/strip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="-"
                    android:textSize="5sp"
                    android:textColor="@color/black"
                    android:textStyle="bold" />
                <TextView
                    android:id="@+id/tmp1_tgl_keluar_perusahan_txt"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="14 Desember 2014"
                    android:textSize="5sp"
                    android:textColor="@color/black"
                    android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/tmp1_tv_item_ket_peng"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="start"
            android:text="Keterangan"
            android:textColor="@color/black"
            android:textSize="6sp"
            android:paddingTop="4dp"/>

    </LinearLayout>

</LinearLayout>


