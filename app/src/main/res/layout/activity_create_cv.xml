<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".CreateCvActivity"
    android:orientation="vertical"
    android:background="@color/ivory"
    >
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/choose_profile"
        android:layout_marginLeft="10dp"
        android:layout_marginTop="10dp"
        android:textStyle ="bold"
        />
    <Spinner
        android:id="@+id/choose_profil"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_alignParentLeft="true"
        android:layout_alignParentStart="true"
        android:layout_marginTop="0dp"
        android:background="@drawable/blue_outline"
        tools:ignore="MissingConstraints" />
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/choose_template"
        android:layout_marginLeft="10dp"
        android:layout_marginTop="15dp"
        android:textStyle ="bold"
        />
    <Spinner
        android:id="@+id/choose_template"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_alignParentLeft="true"
        android:layout_alignParentStart="true"
        android:layout_marginTop="0dp"
        android:background="@drawable/blue_outline"
        tools:ignore="MissingConstraints" />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center|bottom"
        android:orientation="vertical"
        android:paddingTop="10dp">
        <Button
            android:id="@+id/test_nama"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/next"
            android:textColor="@color/black"
            tools:ignore="MissingConstraints"
            android:background="@drawable/button_round_delete"
            android:layout_gravity="center_vertical|center_horizontal"
            />
    </LinearLayout>
    <ImageView
        android:id="@+id/imgtemplate"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginBottom="20dp"
        android:layout_marginTop="10dp"
        />
</LinearLayout>