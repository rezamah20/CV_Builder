<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".detail_user.EditBahasaActivity"
    android:orientation="vertical">


    <com.google.android.material.textfield.TextInputLayout
        style="?attr/textInputOutlinedDenseStyle"
        android:id="@+id/isi_bahasa"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Masukan Bahasa"
        android:text="Masukan Bahasa"
        tools:ignore="MissingConstraints"
        app:hintTextColor="@color/black"
        app:boxStrokeColor="@color/black"
        app:boxStrokeErrorColor="@color/black"
        android:textAppearance="@color/black"
        app:shapeAppearance="@style/CustomShapeOVerlay"
        android:enabled="true"
        app:endIconMode="clear_text"
        app:boxStrokeWidthFocused="2dp"
        android:paddingTop="16dp"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        app:hintAnimationEnabled="true"
        app:helperText="Masukan Bahasa"
        >

        <com.google.android.material.textfield.TextInputEditText
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:id="@+id/isi_bahasa_et"
            />

    </com.google.android.material.textfield.TextInputLayout>


    <Spinner
        android:id="@+id/level_bahasa"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="16dp"
        android:paddingLeft="14dp"
        android:paddingRight="16dp"
        android:textColor="#FF0000"
        android:layout_gravity="center_vertical|center_horizontal"
        android:spinnerMode="dropdown" />


</LinearLayout>