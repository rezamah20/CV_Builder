<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    >
        <LinearLayout
            android:id="@+id/invoice_layout"
            android:layout_width="1100px"
            android:layout_height="1556px"
            android:layout_above="@+id/generate_invoice_btn"
            android:background="@drawable/tmp1_bg"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/name"
                    android:layout_width="280dp"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tv_item_nama_tmp"
                        android:layout_width="240dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="25dp"
                        android:layout_marginTop="30dp"
                        android:layout_marginBottom="0dp"
                        android:fontFamily="@font/robotoregular"
                        android:gravity="start"
                        android:text="INI NAMA TEST"
                        android:textAllCaps="true"
                        android:textColor="@color/black"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_item_posisi_tmp"
                        android:layout_width="240dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="25dp"
                        android:layout_marginBottom="10dp"
                        android:fontFamily="sans-serif"
                        android:gravity="start"
                        android:text="POSISI"
                        android:textColor="@color/black"
                        android:textSize="15sp" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="2dp"
                        android:orientation="horizontal">

                        <ImageView
                            android:id="@+id/tmp_imgemail"
                            android:layout_width="8dp"
                            android:layout_height="8dp"
                            android:layout_gravity="right"
                            android:layout_marginStart="25dp"
                            android:layout_marginEnd="4dp"

                            android:scaleType="fitXY"
                            android:src="@drawable/tmp1_hp_"
                            tools:ignore="MissingConstraints,RtlHardcoded" />

                        <TextView
                            android:id="@+id/tmp_tv_nohp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="2dp"
                            android:layout_marginBottom="3dp"
                            android:fontFamily="sans-serif"
                            android:gravity="start"
                            android:text="089666002011"
                            android:textColor="@color/black"
                            android:textSize="6sp" />

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="2dp"
                        android:orientation="horizontal">

                        <ImageView
                            android:id="@+id/tmp1_imgnohp"
                            android:layout_width="8dp"
                            android:layout_height="8dp"
                            android:layout_marginStart="25dp"
                            android:layout_marginEnd="4dp"

                            android:scaleType="fitXY"
                            android:src="@drawable/tmp1_email"
                            tools:ignore="MissingConstraints,RtlHardcoded" />

                        <TextView
                            android:id="@+id/tmp_tv_email"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="2dp"
                            android:layout_marginBottom="3dp"
                            android:fontFamily="sans-serif"
                            android:gravity="start"
                            android:text="agusnihbossenggoldong@gmail.com"
                            android:textColor="@color/black"
                            android:textSize="6sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <ImageView
                            android:id="@+id/tmp1_alamat"
                            android:layout_width="8dp"
                            android:layout_height="8dp"
                            android:layout_marginStart="25dp"
                            android:layout_marginEnd="4dp"
                            android:scaleType="fitXY"
                            android:src="@drawable/tmp1_addr"
                            tools:ignore="MissingConstraints,RtlHardcoded" />

                        <TextView
                            android:id="@+id/tmp_tv_alamat"
                            android:layout_width="216dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="2dp"
                            android:layout_marginBottom="1dp"
                            android:fontFamily="sans-serif"
                            android:gravity="start"
                            android:text="Jalan Jalan"
                            android:textColor="@color/black"
                            android:textSize="6sp" />
                    </LinearLayout>

                </LinearLayout>

                <ImageView
                    android:id="@+id/tmp1_imgview"
                    android:layout_width="105dp"
                    android:layout_height="145dp"
                    android:layout_gravity="right"
                    android:paddingTop="30dp"
                    android:scaleType="fitXY"
                    android:src="@drawable/img_user"
                    tools:ignore="MissingConstraints,RtlHardcoded" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="45dp"
                android:orientation="horizontal"
                android:paddingLeft="25dp"
                android:paddingTop="20dp">

                <LinearLayout
                    android:layout_width="199dp"
                    android:layout_height="match_parent"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="153dp"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif"
                        android:text="PROFIL"
                        android:textColor="@color/black"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <View
                        android:layout_width="175dp"
                        android:layout_height="1dp"
                        android:layout_gravity="bottom"
                        android:background="@color/black" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="153dp"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif"
                        android:text="SKILL"
                        android:textColor="@color/black"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <View
                        android:layout_width="150dp"
                        android:layout_height="1dp"
                        android:layout_gravity="bottom"
                        android:background="@color/black" />
                </LinearLayout>


            </LinearLayout>

            <LinearLayout
                android:layout_width="1000px"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingLeft="25dp"
                android:paddingTop="4dp">

                <LinearLayout
                    android:layout_width="199dp"
                    android:layout_height="match_parent"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tv_profil_tmp"
                        android:layout_width="170dp"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif"
                        android:justificationMode="inter_word"
                        android:text="PROFIL"
                        android:textColor="@color/black"
                        android:textSize="8sp" />

                    <LinearLayout
                        android:layout_width="1000px"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:paddingLeft="0dp"
                        android:paddingTop="4dp">

                        <LinearLayout
                            android:layout_width="199dp"
                            android:layout_height="match_parent"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="153dp"
                                android:layout_height="wrap_content"
                                android:fontFamily="sans-serif"
                                android:text="PENGALAMAN"
                                android:textColor="@color/black"
                                android:textSize="16sp"
                                android:textStyle="bold" />

                            <View
                                android:layout_width="175dp"
                                android:layout_height="1dp"
                                android:layout_gravity="bottom"
                                android:background="@color/black" />

                            <androidx.recyclerview.widget.RecyclerView
                                android:id="@+id/tmp1_rview_pengalaman"
                                android:layout_width="170dp"
                                android:layout_height="360dp"
                                android:paddingLeft="0dp"
                                tools:ignore="MissingConstraints" />
                        </LinearLayout>
                    </LinearLayout>

                </LinearLayout>

                <LinearLayout
                    android:layout_width="199dp"
                    android:layout_height="match_parent"
                    android:orientation="vertical">

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rview_template"
                        android:layout_width="157dp"
                        android:layout_height="wrap_content"
                        tools:ignore="MissingConstraints" />

                    <TextView
                        android:layout_width="153dp"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif"
                        android:paddingTop="4dp"
                        android:text="PENDIDIKAN"
                        android:textColor="@color/black"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <View
                        android:layout_width="150dp"
                        android:layout_height="1dp"
                        android:layout_gravity="bottom"
                        android:background="@color/black" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/tmp1_rview_pendidikan"
                        android:layout_width="154dp"
                        android:layout_height="wrap_content"
                        tools:ignore="MissingConstraints" />


                    <LinearLayout
                        android:layout_width="199dp"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:paddingBottom="30dp">

                        <TextView
                            android:layout_width="153dp"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif"
                            android:paddingTop="4dp"
                            android:text="BAHASA"
                            android:textColor="@color/black"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <View
                            android:layout_width="150dp"
                            android:layout_height="1dp"
                            android:layout_gravity="bottom"
                            android:background="@color/black" />

                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/tmp1_rview_bahasa"
                            android:layout_width="154dp"
                            android:layout_height="wrap_content"
                            tools:ignore="MissingConstraints" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center|bottom"
        android:orientation="vertical"
        >
        <Button
            android:id="@+id/generate_invoice_btn"
            android:layout_width="150dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Buat PDF"
            android:layout_gravity="center_horizontal|center"
            android:background="@drawable/button_round_delete"
            android:layout_marginBottom="40dp"
            />
    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>