<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".DataUserActivity">

    <ImageView
        android:id="@+id/data_img_user"
        android:layout_width="150dp"
        android:layout_height="150dp"
        android:layout_gravity="center_vertical"
        android:src="@drawable/img_user"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        tools:ignore="MissingConstraints"
        tools:layout_editor_absoluteY="42dp"
        />

    <Button
        android:id="@+id/edit_profil"
        android:layout_width="300dp"
        android:layout_height="50dp"
        android:background="@drawable/button_round_datauser"
        android:text="Edit Profil"
        android:textColor="@color/black"
        android:textStyle="bold"
        tools:ignore="MissingConstraints"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        tools:layout_editor_absoluteY="42dp"
        android:drawableLeft= "@drawable/icon_profil"
        android:layout_gravity="center_vertical"
        app:layout_constraintTop_toBottomOf="@+id/data_img_user"
        android:layout_margin="16dp"
        android:paddingLeft="16dp"
        />
    <Button
        android:id="@+id/edit_kontak"
        android:layout_width="300dp"
        android:layout_height="50dp"
        android:background="@drawable/button_round_datauser"
        android:text="Edit Kontak"
        android:textColor="@color/black"
        android:textStyle="bold"
        tools:ignore="MissingConstraints"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        tools:layout_editor_absoluteY="42dp"
        android:drawableLeft= "@drawable/icon_contact"
        android:layout_gravity="center_vertical"
        app:layout_constraintTop_toBottomOf="@+id/edit_profil"
        android:layout_margin="10dp"
        android:paddingLeft="16dp"
        />
    <Button
        android:id="@+id/edit_pendidikan"
        android:layout_width="300dp"
        android:layout_height="50dp"
        android:background="@drawable/button_round_datauser"
        android:text="Edit Pendidikan"
        android:textColor="@color/black"
        android:textStyle="bold"
        tools:ignore="MissingConstraints"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        tools:layout_editor_absoluteY="42dp"
        android:drawableLeft= "@drawable/icon_pendidikan"
        android:layout_gravity="center_vertical"
        app:layout_constraintTop_toBottomOf="@+id/edit_kontak"
        android:layout_margin="10dp"
        android:paddingLeft="16dp"
        />
    <Button
        android:id="@+id/edit_skill"
        android:layout_width="300dp"
        android:layout_height="50dp"
        android:background="@drawable/button_round_datauser"
        android:text="Edit Skill"
        android:textColor="@color/black"
        android:textStyle="bold"
        tools:ignore="MissingConstraints"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        tools:layout_editor_absoluteY="42dp"
        android:drawableLeft= "@drawable/icon_skills"
        android:layout_gravity="center_vertical"
        app:layout_constraintTop_toBottomOf="@+id/edit_pendidikan"
        android:layout_margin="10dp"
        android:paddingLeft="16dp"
        />
    <Button
        android:id="@+id/edit_bahasa"
        android:layout_width="300dp"
        android:layout_height="50dp"
        android:background="@drawable/button_round_datauser"
        android:text="Edit Bahasa"
        android:textColor="@color/black"
        android:textStyle="bold"
        tools:ignore="MissingConstraints"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        tools:layout_editor_absoluteY="42dp"
        android:drawableLeft= "@drawable/icon_bahasa"
        android:layout_gravity="center_vertical"
        app:layout_constraintTop_toBottomOf="@+id/edit_skill"
        android:layout_margin="10dp"
        android:paddingLeft="16dp"
        />
    <Button
        android:id="@+id/edit_pengalaman"
        android:layout_width="300dp"
        android:layout_height="50dp"
        android:background="@drawable/button_round_datauser"
        android:text="Edit Pengalaman"
        android:textColor="@color/black"
        android:textStyle="bold"
        tools:ignore="MissingConstraints"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        tools:layout_editor_absoluteY="42dp"
        android:drawableLeft= "@drawable/icon_pengalaman"
        android:layout_gravity="center_vertical"
        app:layout_constraintTop_toBottomOf="@+id/edit_bahasa"
        android:layout_margin="10dp"
        android:paddingLeft="16dp"
        />




</androidx.constraintlayout.widget.ConstraintLayout>